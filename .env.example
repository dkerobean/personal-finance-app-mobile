# Copy this file to .env and fill in your actual values

# Public mobile app configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
EXPO_PUBLIC_API_URL=https://your-api.example.com/api
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
EXPO_PUBLIC_MONO_APP_ID=your_mono_app_id
EXPO_PUBLIC_MONO_PUBLIC_KEY=your_mono_public_key

# Server-side secrets
# Do not expose these through EXPO_PUBLIC_* variables or app.config.js.
# Keep them in your backend, Supabase secrets, or CI build secrets instead.
# MONGODB_URI=
# RESEND_API_KEY=
# CLERK_SECRET_KEY=
# MONO_SECRET_KEY=
# ONESIGNAL_REST_API_KEY=
